{
  "expo": {
    "name": "SSBFY",
    "slug": "ssbfy-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/new_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#fafbff"
    },
    "ios": {
      "supportsTablet": true
    },
    "scheme": "ssbfy",
    "android": {
      "package": "com.ayoobbhat.ssbfy",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.jkssbfy.in",
              "pathPrefix": "/battle"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 35,
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/new_icon.png",
        "backgroundColor": "#fafbff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/new_icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2e3b7e02-f1df-461b-9d2a-071b1481d8d1"
      }
    },
    "owner": "ayoobbhat",
    "plugins": [
      "expo-web-browser",
      "./plugins/withAdiRegistration",
      "@sentry/react-native",
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7420252276948628~4551564612",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ]
  }
}
