# Expo public env — copy to `.env` in this folder.
# EXPO_PUBLIC_* are inlined at build time; restart Expo after changes.
# https://docs.expo.dev/guides/environment-variables/

# Backend API (HTTPS in production). Falls back to baked-in prod URL if unset.
EXPO_PUBLIC_API_BASE_URL=

# Sentry — crash/error reporting for React Native (leave empty to disable)
EXPO_PUBLIC_SENTRY_DSN=

# Set to 1 to send Sentry events while developing (__DEV__). Default: off in dev.
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=

# Google Sign-In — public OAuth client IDs (no secrets in the app)
# Web client ID is required for Android ID tokens (set as webClientId in GoogleSignin.configure).
# Android client ID is used by the backend audience allowlist — keep both in sync with Google Cloud.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Support & Feedback — Google Form URL opened from Profile
EXPO_PUBLIC_FEEDBACK_FORM_URL=
EXPO_PUBLIC_FEEDBACK_FORM_TYPE_ENTRY_ID=
